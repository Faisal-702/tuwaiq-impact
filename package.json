    "test:student-codes": "node tests/e2e/student-codes.mjs",
    "test:student-sections": "node --env-file-if-exists=.env.local tests/e2e/student-sections.mjs",
    "test:admin-login": "node --env-file-if-exists=.env.local tests/e2e/admin-login.mjs",
    "mock:supabase-auth": "node tests/e2e/mock-supabase-auth.mjs",
