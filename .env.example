# ---------------------------------------------------------------------------
# Tuwaiq Impact — environment configuration
# Copy to .env.local for development. Never commit real values.
# None of these variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string (server only).
# On Vercel/serverless use the Supabase *transaction pooler* URL (port 6543).
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres


# Long random secret used to sign upload URLs and anonymise view counts.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Media storage: "supabase" (production) or "local" (development only).
STORAGE_DRIVER=supabase

# Supabase project (server only — the service-role key must never reach the browser).
# Used for Storage and for administrator sign-in (Supabase Auth email + password).
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-media

# Administrator sign-in: administrators are the users in Supabase
# (Authentication → Users). SUPABASE_ANON_KEY (the project's anon/publishable
# key) is used to verify their password; if empty, the service-role key is used.
SUPABASE_ANON_KEY=
# Optional allowlist of administrator emails (comma-separated). When set, only
# these Supabase users can open the dashboard.
ADMIN_EMAILS=
