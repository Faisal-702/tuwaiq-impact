# ---------------------------------------------------------------------------
# Tuwaiq Impact — environment configuration
# Copy to .env.local for development. Never commit real values.
# None of these variables are exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string (server only).
# On Vercel/serverless use the Supabase *transaction pooler* URL (port 6543).
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres

# Administrator access code, validated server-side only.
ADMIN_ACCESS_CODE=

# Long random secret used to sign upload URLs and anonymise view counts.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Media storage: "supabase" (production) or "local" (development only).
STORAGE_DRIVER=supabase

# Supabase Storage (server only — the service-role key must never reach the browser).
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-media
